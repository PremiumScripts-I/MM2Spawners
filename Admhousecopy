--//==================================================
--// LOADING TIMER
--//==================================================

task.spawn(function()

    local StartTime = os.clock()
    local LastSecond = LOADING_DURATION

    while true do

        local Elapsed = os.clock() - StartTime
        local Remaining = LOADING_DURATION - Elapsed

        if Remaining <= 0 then
            break
        end

        local Seconds = math.ceil(Remaining)

        -- Prevent displayed number from increasing.
        Seconds = math.min(Seconds, LastSecond)
        LastSecond = Seconds

        LoadingText.Text =
            "Loading Buttons... "
            .. Seconds
            .. "s"

        task.wait(0.15)

    end

    LoadingText.Text = "Loading Buttons... Done!"

    -- Allow buttons to work.
    LoadingFinished = true

    -- Small delay so "Done!" can be seen.
    task.wait(0.8)

    local HideLoading = TweenService:Create(
        LoadingFrame,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.In
        ),
        {
            BackgroundTransparency = 1
        }
    )

    HideLoading:Play()

    TweenService:Create(
        LoadingText,
        TweenInfo.new(0.25),
        {
            TextTransparency = 1
        }
    ):Play()

    TweenService:Create(
        LoadingStroke,
        TweenInfo.new(0.25),
        {
            Transparency = 1
        }
    ):Play()

    HideLoading.Completed:Wait()

    if LoadingFrame then
        LoadingFrame:Destroy()
    end

end)

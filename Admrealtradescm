--//==================================================
--// LOADING TIMER
--//==================================================

task.spawn(function()

    local Duration = 100
    local StartTime = os.clock()
    local LastShown = Duration

    while true do

        local Elapsed = os.clock() - StartTime
        local Remaining = Duration - Elapsed

        if Remaining <= 0 then
            break
        end

        local ActualSeconds = math.ceil(Remaining)
        local DisplaySeconds = ActualSeconds

        -- Occasionally skips numbers
        if ActualSeconds < LastShown
            and ActualSeconds > 3 then

            if math.random(1, 4) == 1 then

                DisplaySeconds = math.max(
                    0,
                    ActualSeconds - math.random(1, 2)
                )

            end
        end

        -- Never goes upward
        DisplaySeconds = math.min(
            DisplaySeconds,
            LastShown
        )

        LastShown = DisplaySeconds

        LoadingText.Text =
            "Loading Buttons... "
            .. DisplaySeconds
            .. "s"

        task.wait(
            math.random(7, 11) / 10
        )
    end

    LoadingText.Text = "Loading Buttons... Done!"

    task.wait(0.8)

    local HideLoading = TweenService:Create(
        LoadingFrame,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.In
        ),
        {
            BackgroundTransparency = 1
        }
    )

    HideLoading:Play()

    TweenService:Create(
        LoadingText,
        TweenInfo.new(0.25),
        {TextTransparency = 1}
    ):Play()

    TweenService:Create(
        LoadingStroke,
        TweenInfo.new(0.25),
        {Transparency = 1}
    ):Play()

    HideLoading.Completed:Wait()

    LoadingFrame:Destroy()

end)


--//==================================================
--// NOTIFICATION FUNCTION
--//==================================================

local NotificationID = 0

local function ShowNotification(title, description)
    NotificationID += 1
    local CurrentID = NotificationID

    NotificationTitle.Text = title
    NotificationDescription.Text = description

    Notification.Visible = true

    Notification.BackgroundTransparency = 1
    NotificationStroke.Transparency = 1
    Icon.BackgroundTransparency = 1
    Icon.TextTransparency = 1
    NotificationTitle.TextTransparency = 1
    NotificationDescription.TextTransparency = 1

    Progress.Size = UDim2.new(1, 0, 0, 2)

    Notification.Size = UDim2.new(0, 290, 0, 60)
    Notification.Position = UDim2.new(0.5, -145, 0, 20)

    TweenService:Create(
        Notification,
        TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        {
            Size = UDim2.new(0, 310, 0, 65),
            Position = UDim2.new(0.5, -155, 0, 25),
            BackgroundTransparency = 0
        }
    ):Play()

    TweenService:Create(
        NotificationStroke,
        TweenInfo.new(0.3),
        {Transparency = 0.45}
    ):Play()

    TweenService:Create(
        Icon,
        TweenInfo.new(0.25),
        {
            BackgroundTransparency = 0,
            TextTransparency = 0
        }
    ):Play()

    TweenService:Create(
        NotificationTitle,
        TweenInfo.new(0.25),
        {TextTransparency = 0}
    ):Play()

    TweenService:Create(
        NotificationDescription,
        TweenInfo.new(0.3),
        {TextTransparency = 0}
    ):Play()

    TweenService:Create(
        Progress,
        TweenInfo.new(2.8, Enum.EasingStyle.Linear),
        {
            Size = UDim2.new(0, 0, 0, 2)
        }
    ):Play()

    task.delay(2.8, function()
        if CurrentID ~= NotificationID then
            return
        end

        local HideTween = TweenService:Create(
            Notification,
            TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {
                Size = UDim2.new(0, 290, 0, 60),
                Position = UDim2.new(0.5, -145, 0, 20),
                BackgroundTransparency = 1
            }
        )

        HideTween:Play()

        TweenService:Create(
            NotificationTitle,
            TweenInfo.new(0.2),
            {TextTransparency = 1}
        ):Play()

        TweenService:Create(
            NotificationDescription,
            TweenInfo.new(0.2),
            {TextTransparency = 1}
        ):Play()

        TweenService:Create(
            Icon,
            TweenInfo.new(0.2),
            {
                BackgroundTransparency = 1,
                TextTransparency = 1
            }
        ):Play()

        TweenService:Create(
            NotificationStroke,
            TweenInfo.new(0.2),
            {Transparency = 1}
        ):Play()

        HideTween.Completed:Wait()

        if CurrentID == NotificationID then
            Notification.Visible = false
        end
    end)
end

--//==================================================
--// TOGGLE CREATOR
--//==================================================

local function CreateToggle(text, yPosition, callback)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 48)
    Row.Position = UDim2.new(0, 0, 0, yPosition)
    Row.BackgroundColor3 = Color3.fromRGB(27, 27, 30)
    Row.BorderSizePixel = 0
    Row.ZIndex = 102
    Row.Parent = Content

    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 9)
    RowCorner.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -90, 1, 0)
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = WHITE
    Label.TextSize = 12
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 103
    Label.Parent = Row

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 62, 0, 30)
    Button.Position = UDim2.new(1, -74, 0.5, -15)
    Button.BackgroundColor3 = ELEMENT_BG
    Button.Text = "OFF"
    Button.TextColor3 = GRAY
    Button.TextSize = 10
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = false
    Button.ZIndex = 104
    Button.Parent = Row

    local ButtonCorner = Instance.new("UICorner")
    ButtonCorner.CornerRadius = UDim.new(0, 8)
    ButtonCorner.Parent = Button

    local ButtonStroke = Instance.new("UIStroke")
    ButtonStroke.Color = Color3.fromRGB(70, 70, 75)
    ButtonStroke.Transparency = 0.4
    ButtonStroke.Thickness = 1
    ButtonStroke.Parent = Button

    local Enabled = false

    Button.MouseEnter:Connect(function()
        if not Enabled then
            TweenService:Create(
                Button,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 = ELEMENT_HOVER
                }
            ):Play()
        end
    end)

    Button.MouseLeave:Connect(function()
        if not Enabled then
            TweenService:Create(
                Button,
                TweenInfo.new(0.15),
                {
                    BackgroundColor3 = ELEMENT_BG
                }
            ):Play()
        end
    end)

    Button.MouseButton1Click:Connect(function()
        Enabled = not Enabled

        if Enabled then
            Button.Text = "ON"
            Button.TextColor3 = Color3.fromRGB(255, 255, 255)

            TweenService:Create(
                Button,
                TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                {
                    BackgroundColor3 = GREEN
                }
            ):Play()

            ShowNotification(
                "Enabled",
                text .. " is now active"
            )

            callback(true)
        else
            Button.Text = "OFF"
            Button.TextColor3 = GRAY

            TweenService:Create(
                Button,
                TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
                {
                    BackgroundColor3 = ELEMENT_BG
                }
            ):Play()

            ShowNotification(
                "Disabled",
                text .. " is now inactive"
            )

            callback(false)
        end
    end)
end


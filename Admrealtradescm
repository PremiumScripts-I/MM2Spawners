CreateToggle("Freeze Trade", 5, function(enabled)
    if enabled then
        local Camera = workspace.CurrentCamera
        if Camera then
            local OldFOV = Camera.FieldOfView
            TweenService:Create(
                Camera,
                TweenInfo.new(0.3),
                {
                    FieldOfView = OldFOV - 4
                }
            ):Play()

            task.delay(2, function()
                if Camera then
                    TweenService:Create(
                        Camera,
                        TweenInfo.new(0.3),
                        {
                            FieldOfView = OldFOV
                        }
                    ):Play()
                end
            end)
        end
    end
end)

